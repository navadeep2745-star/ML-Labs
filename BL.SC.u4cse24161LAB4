import pandas as pd
import numpy as np
def minkowski_distance(point1, point2, p):
    return (np.sum(np.abs(point1 - point2) ** p)) ** (1 / p)
df = pd.read_excel("Lab Session Data.xlsx", sheet_name="marketing_campaign")
