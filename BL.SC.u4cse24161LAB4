import numpy as np
import pandas as pd
df = pd.read_excel("Lab Session Data.xlsx", sheet_name="marketing_campaign")
data = df[["Income", "MntWines"]].dropna().to_numpy()
c1 = data[0]
c2 = data[3]
for i in range(3):
    cluster1 = []
    cluster2 = []
    for point in data:
        d1 = np.linalg.norm(point - c1)
        d2 = np.linalg.norm(point - c2)
        if d1 < d2:
            cluster1.append(point)
        else:
            cluster2.append(point)
    c1 = np.mean(cluster1, axis=0)
    c2 = np.mean(cluster2, axis=0)
print("Centroid 1:", c1)
print("Centroid 2:", c2)
print("Cluster 1:")
print(cluster1)
print("Cluster 2:")
print(cluster2)

import pandas as pd
import numpy as np
df = pd.read_excel("Lab Session Data.xlsx", sheet_name="marketing_campaign")
data = df[["Income", "MntWines"]].dropna().to_numpy()
k = 2
centroids = data[:k]

for iteration in range(5):
    clusters = []
    for point in data:

        distances = []

        for centroid in centroids:
            distance = np.sqrt(np.sum((point - centroid) ** 2))
            distances.append(distance)

        cluster = np.argmin(distances)
        clusters.append(cluster)


    new_centroids = []

    for i in range(k):

        cluster_points = data[np.array(clusters) == i]

        new_centroid = np.mean(cluster_points, axis=0)

        new_centroids.append(new_centroid)

    centroids = np.array(new_centroids)


print("Final Centroids:")
print(centroids)
print("\nCluster Assignment:")
for i in range(len(data)):
    print(data[i], "-> Cluster", clusters[i])

