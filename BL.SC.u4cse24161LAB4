import pandas as pd

def label_encoding(data, column):
    values = data[column].unique()
    mapping = {}
    for i in range(len(values)):
        mapping[values[i]] = i
    data[column] = data[column].map(mapping)
    return data

df = pd.read_excel("Lab Session Data.xlsx", sheet_name="marketing_campaign")

df = label_encoding(df, "Education")
df = label_encoding(df, "Marital_Status")

print(df.head())

import pandas as pd
def one_hot_encoding(data, column):
    values = data[column].unique()
    for value in values:
        data[column + "_" + str(value)] = (data[column] == value).astype(int)
    data = data.drop(column, axis=1)
    return data
df = pd.read_excel("Lab Session Data.xlsx", sheet_name="marketing_campaign")
df = one_hot_encoding(df, "Education")
df = one_hot_encoding(df, "Marital_Status")
print(df.head())

